{
  "name": "aep-referee-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "dev": "next dev --turbopack -p 3000",
    "local": "next dev --turbopack -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "start:local": "next build && next start -p 3000",
    "lint": "eslint src tests scripts playwright.config.ts playwright.local.config.ts playwright.prod.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "audit:prod": "node scripts/production-readiness-check.mjs",
    "audit:security": "node scripts/security-audit.mjs",
    "audit:remote": "node --env-file=.env.local scripts/supabase-readiness-audit.mjs",
    "verify": "npm run audit:prod && npm run audit:security && npm run lint && npm run typecheck && npm run test && npm run build",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:local": "playwright test -c playwright.local.config.ts --trace off",
    "e2e:prod": "playwright test -c playwright.prod.config.ts --trace off",
    "e2e:install": "playwright install chromium",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed": "npx tsx --env-file=.env.local scripts/seed.ts",
    "db:backup": "node --env-file=.env.local scripts/backup-supabase.mjs create",
    "db:backup:verify": "node scripts/backup-supabase.mjs verify",
    "migration:status": "node scripts/migration-status.mjs",
    "db:restore:dry-run": "node --env-file=.env.local scripts/backup-supabase.mjs restore-dry-run",
    "db:backfill-templates": "npx tsx --env-file=.env.local scripts/backfill-templates.ts",
    "db:import-judges": "npx tsx --env-file=.env.local scripts/import-judges-registry.ts",
    "docs:screenshots": "node scripts/capture-docs-screenshots.mjs",
    "supabase:email-branding": "npx tsx scripts/apply-supabase-auth-branding.ts",
    "db:cleanup-demo": "npx tsx --env-file=.env.local scripts/cleanup-demo-data.ts"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.105.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.79.0",
    "next": "^16.4.6",
    "pdfjs-dist": "^6.5.438",
    "pdfkit": "^0.21.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "overrides": {
    "postcss": "^8.5.14",
    "sharp": "^0.35.5",
    "fast-uri": "^3.1.8",
    "source-map-js": "^1.2.2",
    "vite": "~8.1.7",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.1.7",
    "@types/node": "^22.15.21",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9.27.0",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
    "vitest": "^5.1.1"
  }
}
