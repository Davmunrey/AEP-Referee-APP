# ─── Modo local (recomendado) ─────────────────────────────────────────────
# Copia a .env.local si quieres forzar local también en `npm run start`:
# NEXT_PUBLIC_RUN_LOCAL=true
# NEXT_PUBLIC_DEMO_MODE=true
# NEXT_PUBLIC_LOCAL_API_URL=http://localhost:3000/api/v1

# En `npm run dev`, .env.development ya activa modo local + demo automáticamente.

# ─── API externa (solo si NO usas local) ───────────────────────────────────
# NEXT_PUBLIC_API_URL=https://api.aep-tarima.es/v1
