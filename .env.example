# Supabase (Postgres + Auth)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Seed / backfill (scripts)
# SEED_DEFAULT_PASSWORD=ChangeMe2026!

# Asistente de ayuda con IA (opcional; si falta la clave, el asistente usa el
# motor LOCAL sobre la documentación). La clave se lee SOLO en el servidor —
# nunca uses el prefijo NEXT_PUBLIC_ ni la incluyas en el código/commits.
# GEMINI_API_KEY=tu-clave-de-google-ai-studio
# GEMINI_MODEL=gemini-2.0-flash

# Push APNs para la app iOS nativa (opcional; si faltan, las push son no-op)
# APNS_KEY_ID=ABC123DEFG
# APNS_TEAM_ID=DEF456GHIJ
# APNS_BUNDLE_ID=es.aep.tarima
# APNS_KEY_P8="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
