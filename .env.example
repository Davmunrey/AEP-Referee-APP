# Supabase (Postgres + Auth)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Seed / backfill (scripts)
# SEED_DEFAULT_PASSWORD=ChangeMe2026!

# Asistente de ayuda con IA (opcional; si falta la clave, el asistente usa el
# motor LOCAL sobre la documentación). La clave se lee SOLO en el servidor —
# nunca uses el prefijo NEXT_PUBLIC_ ni la incluyas en el código/commits.
# GEMINI_API_KEY=tu-clave-de-google-ai-studio
# GEMINI_MODEL=gemini-2.0-flash

# Push APNs para la app iOS nativa (opcional; si faltan, las push son no-op)
# APNS_KEY_ID=ABC123DEFG
# APNS_TEAM_ID=DEF456GHIJ
# APNS_BUNDLE_ID=es.aep.tarima
# APNS_KEY_P8="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Observabilidad / error-tracking con Sentry (opcional; sin DSN es un no-op
# total y no afecta al build). El DSN de cliente debe ser público.
# NEXT_PUBLIC_SENTRY_DSN=<pega-aqui-el-DSN-publico-de-tu-proyecto-Sentry>
# SENTRY_DSN=<el-mismo-DSN-publico>
# Muestreo de trazas (0..1). Por defecto 0.1.
# SENTRY_TRACES_SAMPLE_RATE=0.1
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# Solo para subir source maps en build (CI). Nunca con prefijo NEXT_PUBLIC_.
# SENTRY_ORG=tu-org
# SENTRY_PROJECT=aep-tarima
# SENTRY_AUTH_TOKEN=<token-de-sentry-solo-para-CI>

# OpenStreetMap — geocodificación y distancias (100 % gratuito, sin API key)
# Nominatim (geocoding) y OSRM (rutas). Photon se usa en cliente para autocomplete.
# OSM_USER_AGENT debe identificar tu app (política de uso de Nominatim).
# OSM_USER_AGENT=AEP-Tarima/1.0 (https://tu-dominio.es; contacto@tu-dominio.es)
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# OSRM_URL=https://router.project-osrm.org

# Backup cifrado de Supabase (GitHub Action "Backup"). Si se define este secret
# en el repositorio, el backup diario se cifra (AES256) y se retiene 90 días.
# BACKUP_PASSPHRASE=<frase-secreta-larga-para-cifrar-backups>
