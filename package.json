{
  "name": "aep-referee-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3000",
    "local": "next dev --turbopack -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "start:local": "next build && next start -p 3000",
    "lint": "eslint src",
    "audit:prod": "node scripts/production-readiness-check.mjs",
    "audit:security": "node scripts/security-audit.mjs",
    "audit:remote": "node --env-file=.env.local scripts/supabase-readiness-audit.mjs",
    "verify": "npm run audit:prod && npm run audit:security && npm run lint && npm run test && npm run build",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:install": "playwright install chromium",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed": "npx tsx --env-file=.env.local scripts/seed.ts",
    "db:backup": "node --env-file=.env.local scripts/backup-supabase.mjs create",
    "db:backup:verify": "node scripts/backup-supabase.mjs verify",
    "migration:status": "node scripts/migration-status.mjs",
    "db:restore:dry-run": "node --env-file=.env.local scripts/backup-supabase.mjs restore-dry-run",
    "db:backfill-templates": "npx tsx --env-file=.env.local scripts/backfill-templates.ts",
    "db:import-judges": "npx tsx --env-file=.env.local scripts/import-judges-registry.ts",
    "db:cleanup-demo": "npx tsx --env-file=.env.local scripts/cleanup-demo-data.ts"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@sentry/nextjs": "^10.60.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "next": "^15.3.2",
    "pdf-parse": "^1.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.28"
  },
  "overrides": {
    "postcss": "^8.5.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.1.7",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.2",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
    "vitest": "^4.1.6"
  }
}
