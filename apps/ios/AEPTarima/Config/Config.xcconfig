// Configuración del entorno. Rellena con los datos de tu despliegue.
// Se exponen en Info.plist y se leen en runtime vía AppConfig.
//
// IMPORTANTE: en .xcconfig el "//" inicia un comentario, así que NO se puede
// escribir "https://...". Por eso guardamos solo los HOSTS (sin esquema) y
// AppConfig compone "https://<host>" en código.

API_HOST = TU-DEPLOY.vercel.app
API_BASE_PATH = /api/v1

SUPABASE_HOST = TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY = TU_ANON_KEY
